# Streamed review data is large and reproducible from the corpus; the
# derived, hashed artefacts are what belong in version control.
data/*/reviews.csv
data/*/reviews_raw.jsonl
data/*/scores.csv
*.pyc
__pycache__/

# Refetch cache for the rolling screen; safe to delete, costs only refetch time.
.cache/

# Development/verification venv — numpy and scipy, used only as the oracle the
# in-repo statistics are cross-checked against. Never a pipeline dependency, so
# it is never needed to reproduce a results.jsonl row. Rebuild it from
# requirements-dev.txt; see references/numeric-stack.md.
.venv/
venv/

# Secrets. Never committed — API tokens live here, not in the repo.
.env
.env.*
