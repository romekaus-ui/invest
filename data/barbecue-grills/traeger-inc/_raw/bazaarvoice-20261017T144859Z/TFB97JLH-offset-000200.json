86dHJhZWdlcnNlcnZpY2U/8822c46d-c5a9-5601-8cfd-028fadc23594"},"thumbnail":{"Id":"thumbnail","Url":"https://photos-us.bazaarvoice.com/photo/2/cGhvdG86dHJhZWdlcnNlcnZpY2U/33d98e4c-4c4e-554b-9bc7-45f3027bba64"},"large":{"Id":"large","Url":"https://photos-us.bazaarvoice.com/photo/2/cGhvdG86dHJhZWdlcnNlcnZpY2U/3f4de3f1-74f0-55a2-8210-1dc85b00fcb6"}},"Id":"15941439","SizesOrder":["normal","thumbnail","large"],"Caption":null},{"Sizes":{"normal":{"Id":"normal","Url":"https://photos-us.bazaarvoice.com/photo/2/cGhvdG86dHJhZWdlcnNlcnZpY2U/d168100b-21b5-5b0c-9d55-faf3a3676176"},"thumbnail":{"Id":"thumbnail","Url":"https://photos-us.bazaarvoice.com/photo/2/cGhvdG86dHJhZWdlcnNlcnZpY2U/7bd7069c-45c7-5844-a99d-cb926b183481"},"large":{"Id":"large","Url":"https://photos-us.bazaarvoice.com/photo/2/cGhvdG86dHJhZWdlcnNlcnZpY2U/58d65a9c-b2a6-5627-be62-885a35af2540"}},"Id":"15941440","SizesOrder":["normal","thumbnail","large"],"Caption":null}],"Rating":5,"IsRatingsOnly":false,"Helpfulness":0.800000011920929,"TotalFeedbackCount":5,"TotalNegativeFeedbackCount":1,"TotalPositiveFeedbackCount":4,"ModerationStatus":"APPROVED","SubmissionId":"r117661-en_17341578xBlIuxSmRb","SubmissionTime":"2024-12-14T06:31:35.000+00:00","ReviewText":"I was one of the lucky ones who got to test this grill out before it launched and I have to say it blew me away!  First off, the grilling space inside is huge! The top shelf is really big so I can actually fit a ton of food up on that top shelf. I love the Super Smoke option, it\u2019s a game changer for longer, low temp cooks. The digital dial is so easy to use and controls are super simple. Also the hopper where the pellets go can hold an entire bag of Traeger Pellets! I absolutely love this grill!!! Big props to the people over at Traeger, this thing is amazing!","Title":"This Grill Has It All","UserNickname":null,"ContextDataValues":{"IncentivizedReview":{"Value":"False","Id":"IncentivizedReview"}},"AdditionalFields":{},"CommentIds":[],"AdditionalFieldsOrder":[],"SecondaryRatings":{},"IsRecommended":null,"Badges":{},"ProductRecommendationIds":[],"TagDimensionsOrder":[],"RatingRange":5,"Pros":null,"IsSyndicated":false,"Videos":[],"BadgesOrder":[],"Cons":null,"SecondaryRatingsOrder":[],"ClientResponses":[],"TagDimensions":{}},{"Id":"286920197","CID":"e47a2660-ea2f-5014-9cd7-a122abd5585a","SourceClient":"traegerservice","LastModeratedTime":"2024-12-16T16:30:12.000+00:00","LastModificationTime":"2025-03-01T11:18:01.000+00:00","ProductId":"TFB97JLH","OriginalProductName":"Woodridge\u2122 Pro Pellet Grill","CampaignId":"ridge_all","ContextDataValuesOrder":["IncentivizedReview"],"UserLocation":"Nipomo ca","AuthorId":"ap8l1f75ib65j9dcj03nfzveu","ContentLocale":"en_US","IsFeatured":false,"TotalInappropriateFeedbackCount":0,"TotalClientResponseCount":0,"TotalCommentCount":0,"Rating":5,"IsRatingsOnly":false,"Helpfulness":1.0,"TotalFeedbackCount":2,"TotalNegativeFeedbackCount":0,"TotalPositiveFeedbackCount":2,"ModerationStatus":"APPROVED","SubmissionId":"r117661-en_17341379gp86vSDQ8E","SubmissionTime":"2024-12-14T00:58:40.000+00:00","ReviewText":"The woodridge pro delivered on all my expectations and then some. As a huge fan of the Pro 780 this was the perfect upgrade. I love how easy it is to clean and it eliminates the need for a shop vac. Not to mention the lock in place drip bucket meaning I won\u2019t be knocking it over and spilling grease everywhere. I have over 30 cooks on it and the way the drip pan is set up, all the grease makes it into the bucket. I also love the hopper size, it Easily takes a full bag of pellets and the lid can be used as a second shelf. Love this model!","Title":"Game changer","UserNickname":null,"ContextDataValues":{"IncentivizedReview":{"Value":"False","Id":"IncentivizedReview"}},"AdditionalFields":{},"CommentIds":[],"AdditionalFieldsOrder":[],"SecondaryRatings":{},"IsRecommended":null,"Badges":{},"ProductRecommendationIds":[],"TagDimensionsOrder":[],"RatingRange":5,"InappropriateFeedbackList":[],"Pros