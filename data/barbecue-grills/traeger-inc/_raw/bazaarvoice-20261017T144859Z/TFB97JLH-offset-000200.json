U/d51afc97-fad9-59df-a85b-1f3e4d9ee326"},"large":{"Id":"large","Url":"https://photos-us.bazaarvoice.com/photo/2/cGhvdG86dHJhZWdlcnNlcnZpY2U/848c9abd-3c7a-50db-9fbd-f187c12c3e7a"}},"Id":"15967439","SizesOrder":["normal","thumbnail","large"],"Caption":"Cover"}],"Rating":5,"IsRatingsOnly":false,"Helpfulness":1.0,"TotalFeedbackCount":4,"TotalNegativeFeedbackCount":0,"TotalPositiveFeedbackCount":4,"ModerationStatus":"APPROVED","SubmissionId":"r117661-en_17343766WCBHuxA3Gn","SubmissionTime":"2024-12-16T19:16:44.000+00:00","ReviewText":"This smoker is amazing. I\u2019m brand new to smoking meats and this smoker makes it extremely easy. With the digital temp control and built in thermometer it makes thinks very simple. With the addition of the app anyone can do it. The cover (extra) is worth it as well. It\u2019s heavy and made of great material.","Title":"Amazing smoker!","UserNickname":"Brandan","ContextDataValues":{"IncentivizedReview":{"Value":"True","Id":"IncentivizedReview"}},"AdditionalFields":{},"CommentIds":[],"AdditionalFieldsOrder":[],"SecondaryRatings":{},"IsRecommended":null,"ProductRecommendationIds":[],"TagDimensionsOrder":[],"RatingRange":5,"InappropriateFeedbackList":[],"Pros":null,"IsSyndicated":false,"Videos":[],"Cons":null,"SecondaryRatingsOrder":[],"ClientResponses":[],"TagDimensions":{}},{"Id":"286980680","CID":"9fc8017a-df7d-5a60-854d-d054270ffc32","SourceClient":"traegerservice","LastModeratedTime":"2024-12-16T20:45:06.000+00:00","LastModificationTime":"2025-01-16T13:43:07.000+00:00","ProductId":"TFB97JLH","OriginalProductName":"Woodridge\u2122 Pro Pellet Grill","CampaignId":"ridge_all","ContextDataValuesOrder":["IncentivizedReview"],"UserLocation":"Fairfax Station, VA","AuthorId":"6wzs1kkeo3dgypsgls9etw2gr","ContentLocale":"en_US","IsFeatured":false,"TotalInappropriateFeedbackCount":0,"TotalClientResponseCount":0,"TotalCommentCount":0,"Rating":5,"IsRatingsOnly":false,"Helpfulness":1.0,"TotalFeedbackCount":1,"TotalNegativeFeedbackCount":0,"TotalPositiveFeedbackCount":1,"ModerationStatus":"APPROVED","SubmissionId":"r117661-en_173437511XXBMJoh3B","SubmissionTime":"2024-12-16T18:52:57.000+00:00","ReviewText":"From unboxing to first cook, the grill is amazing.  It helps me create some amazing, wonderful, juicy foods.  I am loving this grill and look forward to the next time I can make ribeyes again.  \r\n\r\nI love the built-in temperature gauge, the app to monitor what is happening, and of course - cooking with a variety of different hardwoods. Easy to clean, easy to operate. Temperature remains fairly constant +- set temp.","Title":"LOVE this grill","UserNickname":"Chad A.","ContextDataValues":{"IncentivizedReview":{"Value":"False","Id":"IncentivizedReview"}},"AdditionalFields":{},"CommentIds":[],"AdditionalFieldsOrder":[],"SecondaryRatings":{},"IsRecommended":null,"Badges":{},"ProductRecommendationIds":[],"TagDimensionsOrder":[],"RatingRange":5,"InappropriateFeedbackList":[],"Pros":null,"IsSyndicated":false,"Videos":[],"BadgesOrder":[],"Cons":null,"SecondaryRatingsOrder":[],"ClientResponses":[],"Photos":[],"TagDimensions":{}},{"Id":"286978360","CID":"6e0bd885-859d-510f-9c0a-a35dcb48bc54","SourceClient":"traegerservice","LastModeratedTime":"2024-12-17T20:15:06.000+00:00","LastModificationTime":"2025-03-01T11:16:47.000+00:00","ProductId":"TFB97JLH","OriginalProductName":"Woodridge\u2122 Pro Pellet Grill","CampaignId":"ridge_all","ContextDataValuesOrder":["IncentivizedReview"],"UserLocation":"Lake Stevens WA","AuthorId":"lrf97n31ps85ge8bjlir30959","ContentLocale":"en_US","IsFeatured":false,"TotalInappropriateFeedbackCount":0,"TotalClientResponseCount":0,"TotalCommentCount":0,"Rating":5,"IsRatingsOnly":false,"Helpfulness":1.0,"TotalFeedbackCount":2,"TotalNegativeFeedbackCount":0,"TotalPositiveFeedbackCount":2,"ModerationStatus":"APPROVED","SubmissionId":"r117661-en_17343739yDHC9z8kzS","SubmissionTime":"2024-12-16T18:31:40.000+00:00","ReviewText":"I've been a grill enthusiast for years, trying countless models, but the Traeger Woodridge Series has completely revolutionized my outdoor cooking experience. This isn't just a grill; it's a culinary masterpiece.\r\n\r\nThe precise temperature control is simply mind-blowing. I can effortlessly smoke, grill, bake, roast, braise, and BBQ with incredible results. The smoky flavor infused into every dish is unparalleled. Whether it's a juicy brisket, tender ribs, or perfectly cooked pizza, the Woodridge delivers.\r\n\r\nThe user-friendly digital controller and Wi-Fi connectivity make it a breeze to monitor and adjust cooking times and temperatures from anywhere. The sleek design and durable construction add to its appeal.\r\n\r\nIf you're serious about outdoor cooking, the Traeger Woodridge Series is the only grill you'll ever need. It's a true game-changer that has earned its place as my go-to grill.","Title":"mr","UserNickname":"Loaris","ContextDataValues":{"IncentivizedReview":{"Value":"False","Id":"IncentivizedReview"}},"AdditionalFields":{},"CommentIds":[],"AdditionalFieldsOrder":[],"SecondaryRatings":{},"IsRecommended":null,"Badges":{},"ProductRecommendationIds":[],"TagDimensionsOrder":[],"RatingRange":5,"InappropriateFeedbackList":[],"Pros":null,"IsSyndicated":false,"Videos":[],"BadgesOrder":[],"Cons":null,"SecondaryRatingsOrder":[],"ClientResponses":[],"Photos":[],"TagDimensions":{}},{"Id":"286977806","CID":"6760a864-7664-5ab1-928e-b790b36c4cc9","SourceClient":"traegerservice","Badges":{"incentivizedReview":{"ContentType":"REVIEW","Id":"incentivizedReview","BadgeType":"Custom"}},"BadgesOrder":["incentivizedReview"],"LastModeratedTime":"2024-12-18T19:00:12.000+00:00","LastModificationTime":"2025-03-01T11:17:09.000+00:00","ProductId":"TFB97JLH","OriginalProductName":"Woodridge\u2122 Pro Pellet Grill","CampaignId":"ridge_all","ContextDataValuesOrder":["IncentivizedReview"],"UserLocation":"Norfolk, NE","AuthorId":"22n12oq40iybxhanjch1xnl1c","ContentLocale":"en_US","IsFeatured":false,"TotalInappropriateFeedbackCount":0,"TotalClientResponseCount":0,"TotalCommentCount":0,"Rating":5,"IsRatingsOnly":false,"Helpfulness":1.0,"TotalFeedbackCount":2,"TotalNegativeFeedbackCount":0,"TotalPositiveFeedbackCount":2,"ModerationStatus":"APPROVED","SubmissionId":"r117661-en_17343727JXh8PYsw47","SubmissionTime":"2024-12-16T18:12:52.000+00:00","ReviewText":"This grill is amazing. Its hard to find a flaw with it. I've smoked everything from roasts, burgers, pizza, turkey, you name it and everything comes out amazing. The controls are easy to adjust temp from either the grill or the app. Notifications on when temps are reached or the grill are preheated are great and seem to work flawless. Grill holds heat very well too for the size.","Title":"Amazing Grill","UserNickname":"MatthewS","ContextDataValues":{"IncentivizedReview":{"Value":"True","Id":"IncentivizedReview"}},"AdditionalFields":{},"CommentIds":[],"AdditionalFieldsOrder":[],"SecondaryRatings":{},"IsRecommended":null,"ProductRecommendationIds":[],"TagDimensionsOrder":[],"RatingRange":5,"InappropriateFeedbackList":[],"Pros":null,"IsSyndicated":false,"Videos":[],"Cons":null,"SecondaryRatingsOrder":[],"ClientResponses":[],"Photos":[],"TagDimensions":{}},{"Id":"286924802","CID":"0c314e96-853c-50d4-bf91-ea036e2e625e","SourceClient":"traegerservice","LastModeratedTime":"2025-02-14T05:45:02.000+00:00","LastModificationTime":"2025-03-04T19:35:53.000+00:00","ProductId":"TFB97JLH","OriginalProductName":"Woodridge\u2122 Pro Pellet Grill","CampaignId":"ridge_all","ContextDataValuesOrder":["IncentivizedReview"],"UserLocation":"Orange County, CA","AuthorId":"z20b97467116w86k2qjflir46i","ContentLocale":"en_US","IsFeatured":false,"InappropriateFeedbackList":[{"AuthorId":"z9wh5u4pu65ayc9qtmh30ej8ed","SubmissionTime":"2025-02-13T21:02:42.000+00:00"}],"TotalInappropriateFeedbackCount":1,"TotalClientResponseCount":0,"TotalCommentCount":0,"Photos":[{"Sizes":{"normal":{"Id":"normal","Url":"https://photos-us.bazaarvoice.com/photo/2/cGhvdG86dHJhZWdlcnNlcnZpY2U/603f94cb-5a11-516d-9c1